{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/simootaz/pantheon-aiops/core/contracts/export/pantheon.schema.json",
  "title": "PantheonContracts",
  "description": "Generated from core/contracts/ by codegen/export_schemas.py. Do not edit by hand.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "a2_u_i_client_capabilities": {
      "$ref": "#/$defs/A2UIClientCapabilities"
    },
    "a2_u_i_surface": {
      "$ref": "#/$defs/A2UISurface"
    },
    "access_request": {
      "$ref": "#/$defs/AccessRequest"
    },
    "action": {
      "$ref": "#/$defs/Action"
    },
    "agent_manifest": {
      "$ref": "#/$defs/AgentManifest"
    },
    "audit_entry": {
      "$ref": "#/$defs/AuditEntry"
    },
    "credential_ref": {
      "$ref": "#/$defs/CredentialRef"
    },
    "event_envelope": {
      "$ref": "#/$defs/EventEnvelope"
    },
    "evidence": {
      "$ref": "#/$defs/Evidence"
    },
    "finding": {
      "$ref": "#/$defs/Finding"
    },
    "grant": {
      "$ref": "#/$defs/Grant"
    },
    "investigation": {
      "$ref": "#/$defs/Investigation"
    },
    "lease": {
      "$ref": "#/$defs/Lease"
    },
    "model_descriptor": {
      "$ref": "#/$defs/ModelDescriptor"
    },
    "model_requirements": {
      "$ref": "#/$defs/ModelRequirements"
    },
    "provider_config": {
      "$ref": "#/$defs/ProviderConfig"
    },
    "resolution_record": {
      "$ref": "#/$defs/ResolutionRecord"
    },
    "u_i_action_response": {
      "$ref": "#/$defs/UIActionResponse"
    },
    "verdict": {
      "$ref": "#/$defs/Verdict"
    }
  },
  "$defs": {
    "A2UIAction": {
      "additionalProperties": false,
      "description": "A declared action on a component.\n\nA2UI carries either a server event or a local function call, both referenced\n**by name**. No executable code crosses the boundary in either direction.",
      "properties": {
        "context": {
          "additionalProperties": true,
          "description": "Values returned with the action.",
          "title": "Context",
          "type": "object"
        },
        "event_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Server-dispatched action name, from the catalog.",
          "title": "Event Name"
        },
        "function_call": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Client function name, from the catalog. Never code.",
          "title": "Function Call"
        }
      },
      "title": "A2UIAction",
      "type": "object"
    },
    "A2UIClientCapabilities": {
      "additionalProperties": false,
      "description": "What the client can render, declared once at run start.\n\nA2UI carries this in A2A message metadata (`a2uiClientCapabilities`). AG-UI\ndefines no analog, so this is **Pantheon convention, not specification**: the\ndashboard sends it in the AG-UI run input, and the agent is told what it may\nemit before it emits anything.\n\n`components` is generated from A2UIComponentType, so what we advertise is\nexactly what the renderer accepts - there is no second list to keep in step.",
      "properties": {
        "a2ui_version": {
          "default": "v0.9.1",
          "title": "A2Ui Version",
          "type": "string"
        },
        "catalog_id": {
          "default": "pantheon.v1",
          "title": "Catalog Id",
          "type": "string"
        },
        "components": {
          "description": "Every component the renderer accepts.",
          "items": {
            "$ref": "#/$defs/A2UIComponentType"
          },
          "title": "Components",
          "type": "array"
        }
      },
      "title": "A2UIClientCapabilities",
      "type": "object"
    },
    "A2UIComponent": {
      "additionalProperties": false,
      "description": "One component in a surface. Authored by an agent, rendered by the host.\n\nNote what is absent: no styling, no HTML, no script, and no identity fields.\n``icon_url`` and ``agent_display_name`` live on A2UISurface and are set by\nthe orchestrator, so an agent cannot present itself as another agent or as\nPantheon itself.",
      "properties": {
        "action": {
          "anyOf": [
            {
              "$ref": "#/$defs/A2UIAction"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "children": {
          "description": "Child component ids.",
          "items": {
            "type": "string"
          },
          "title": "Children",
          "type": "array"
        },
        "component": {
          "$ref": "#/$defs/A2UIComponentType",
          "description": "Must be in the allowlist."
        },
        "data_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "RFC 6901 JSON Pointer into the surface data model.",
          "title": "Data Path"
        },
        "id": {
          "description": "Unique within its surface.",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Input label, where the type takes one.",
          "title": "Label"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Display text, where the type takes one.",
          "title": "Text"
        }
      },
      "required": [
        "id",
        "component"
      ],
      "title": "A2UIComponent",
      "type": "object"
    },
    "A2UIComponentType": {
      "description": "The closed allowlist of A2UI components Pantheon will render.\n\nA subset of A2UI's basic catalog. Agent-generated UI is untrusted data, so\nthe catalog is chosen for what it *cannot* be abused to do.\n\nDeliberately excluded, with reasons:\n\n- ``Image``, ``Video``, ``AudioPlayer`` - each fetches an agent-supplied URL.\n  That outbound request is a data-exfiltration channel: an agent encodes\n  what it learned into the URL and the browser delivers it. Excluded even\n  though they are the most obviously useful components here.\n- ``Modal`` - an agent that can force a modal can overlay a convincing fake\n  credential prompt. Credential requests travel one path only, through\n  Cerberus.\n- ``Tabs``, ``Slider`` - no current use; the allowlist grows on demand and\n  never speculatively.",
      "enum": [
        "Row",
        "Column",
        "Card",
        "List",
        "Text",
        "Icon",
        "Divider",
        "TextField",
        "CheckBox",
        "ChoicePicker",
        "DateTimeInput",
        "Button"
      ],
      "title": "A2UIComponentType",
      "type": "string"
    },
    "A2UISurface": {
      "additionalProperties": false,
      "description": "A renderable surface, assembled by Pantheon rather than by an agent.\n\nIdentity is set here, by the orchestrator, and never by the agent - A2UI\ncalls this out explicitly as an anti-impersonation measure.",
      "properties": {
        "a2ui_version": {
          "default": "v0.9.1",
          "title": "A2Ui Version",
          "type": "string"
        },
        "agent_display_name": {
          "default": "Pantheon",
          "description": "Set by the orchestrator. An agent cannot claim another identity.",
          "title": "Agent Display Name",
          "type": "string"
        },
        "catalog_id": {
          "default": "pantheon.v1",
          "title": "Catalog Id",
          "type": "string"
        },
        "components": {
          "items": {
            "$ref": "#/$defs/A2UIComponent"
          },
          "title": "Components",
          "type": "array"
        },
        "data_model": {
          "additionalProperties": true,
          "description": "Initial values bound by JSON Pointer.",
          "title": "Data Model",
          "type": "object"
        },
        "icon_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Set by the orchestrator. Never agent-supplied.",
          "title": "Icon Url"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "investigation_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Investigation Id"
        },
        "kind": {
          "$ref": "#/$defs/A2UISurfaceKind"
        },
        "root": {
          "description": "Id of the root component.",
          "title": "Root",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "root"
      ],
      "title": "A2UISurface",
      "type": "object"
    },
    "A2UISurfaceKind": {
      "description": "What a Pantheon-authored surface is for.\n\nEvery surface Pantheon emits has a declared purpose, so the renderer can\napply the right handling - notably that only APPROVAL and ACCESS_REQUEST may\ncollect a decision, and both are bound to their existing backend paths.",
      "enum": [
        "approval",
        "access_request",
        "report",
        "notice"
      ],
      "title": "A2UISurfaceKind",
      "type": "string"
    },
    "AccessRequest": {
      "additionalProperties": false,
      "description": "An agent asking for a capability, with the reason it is asking.\n\n`reason` is not decoration. Approving \"an agent wants database access\" is\nnot a decision; approving a stated hypothesis is.",
      "properties": {
        "action": {
          "$ref": "#/$defs/CredentialAction"
        },
        "agent": {
          "title": "Agent",
          "type": "string"
        },
        "credential_ref": {
          "$ref": "#/$defs/CredentialRef"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "investigation_id": {
          "format": "uuid",
          "title": "Investigation Id",
          "type": "string"
        },
        "reason": {
          "description": "The hypothesis this access would test, in the agent's own words.",
          "title": "Reason",
          "type": "string"
        },
        "requested_at": {
          "format": "date-time",
          "title": "Requested At",
          "type": "string"
        },
        "requested_ttl_seconds": {
          "description": "How long the agent expects to need it.",
          "exclusiveMinimum": 0,
          "title": "Requested Ttl Seconds",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "investigation_id",
        "agent",
        "credential_ref",
        "action",
        "reason",
        "requested_ttl_seconds",
        "requested_at"
      ],
      "title": "AccessRequest",
      "type": "object"
    },
    "Action": {
      "additionalProperties": false,
      "description": "A remediation Pantheon proposes, and may later execute.",
      "properties": {
        "approval_state": {
          "$ref": "#/$defs/ApprovalState",
          "default": "pending"
        },
        "blast_radius": {
          "$ref": "#/$defs/BlastRadius"
        },
        "dry_run": {
          "default": true,
          "description": "Dry run until explicitly cleared.",
          "title": "Dry Run",
          "type": "boolean"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "operation": {
          "description": "What it does, e.g. 'rollout_restart'.",
          "title": "Operation",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Why this Action was proposed.",
          "title": "Reason"
        },
        "target": {
          "description": "What it acts on, e.g. 'deployment/checkout'.",
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "id",
        "target",
        "operation",
        "blast_radius"
      ],
      "title": "Action",
      "type": "object"
    },
    "AgentBudget": {
      "additionalProperties": false,
      "description": "Ceilings the dispatcher enforces for a single agent invocation.",
      "properties": {
        "max_seconds": {
          "exclusiveMinimum": 0,
          "title": "Max Seconds",
          "type": "integer"
        },
        "max_tokens": {
          "exclusiveMinimum": 0,
          "title": "Max Tokens",
          "type": "integer"
        },
        "max_tool_calls": {
          "exclusiveMinimum": 0,
          "title": "Max Tool Calls",
          "type": "integer"
        }
      },
      "required": [
        "max_tokens",
        "max_seconds",
        "max_tool_calls"
      ],
      "title": "AgentBudget",
      "type": "object"
    },
    "AgentCapability": {
      "additionalProperties": false,
      "description": "One thing an agent claims it can do.",
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "name": {
          "description": "Stable identifier, e.g. 'detect_metric_anomaly'.",
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name",
        "description"
      ],
      "title": "AgentCapability",
      "type": "object"
    },
    "AgentManifest": {
      "additionalProperties": false,
      "description": "Everything the registry needs to know about an agent without importing it.",
      "properties": {
        "budget": {
          "$ref": "#/$defs/AgentBudget"
        },
        "capabilities": {
          "items": {
            "$ref": "#/$defs/AgentCapability"
          },
          "title": "Capabilities",
          "type": "array"
        },
        "codename": {
          "description": "Mythological name, e.g. 'argus'.",
          "title": "Codename",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "domain": {
          "description": "Folder under agents/, e.g. 'anomaly'.",
          "title": "Domain",
          "type": "string"
        },
        "tools": {
          "description": "Connector tools this agent may call.",
          "items": {
            "type": "string"
          },
          "title": "Tools",
          "type": "array"
        }
      },
      "required": [
        "codename",
        "domain",
        "description",
        "budget"
      ],
      "title": "AgentManifest",
      "type": "object"
    },
    "ApprovalRequestedEvent": {
      "additionalProperties": false,
      "description": "An Action needs a human before it can execute.",
      "properties": {
        "action": {
          "$ref": "#/$defs/Action"
        },
        "investigation_id": {
          "format": "uuid",
          "title": "Investigation Id",
          "type": "string"
        },
        "type": {
          "const": "approval_requested",
          "default": "approval_requested",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "investigation_id",
        "action"
      ],
      "title": "ApprovalRequestedEvent",
      "type": "object"
    },
    "ApprovalState": {
      "description": "Where an Action sits in the human-in-the-loop gate.",
      "enum": [
        "not_required",
        "pending",
        "approved",
        "rejected"
      ],
      "title": "ApprovalState",
      "type": "string"
    },
    "AuditEntry": {
      "additionalProperties": false,
      "description": "One immutable line in the credential audit log.\n\nAttached to the Investigation, which agents can see - safe because every\nreference here is a CredentialRef and never a value.",
      "properties": {
        "action": {
          "$ref": "#/$defs/CredentialAction",
          "default": "not_applicable",
          "description": "NOT_APPLICABLE for events that concern no single access."
        },
        "actor": {
          "description": "Agent codename, user, or 'system'.",
          "title": "Actor",
          "type": "string"
        },
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "credential_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/CredentialRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "detail": {
          "default": "",
          "description": "Human-readable context. Never a credential.",
          "title": "Detail",
          "type": "string"
        },
        "event": {
          "$ref": "#/$defs/AuditEvent"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "investigation_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Investigation Id"
        },
        "lease_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lease Id"
        }
      },
      "required": [
        "id",
        "at",
        "event",
        "actor"
      ],
      "title": "AuditEntry",
      "type": "object"
    },
    "AuditEvent": {
      "description": "Everything Cerberus records. The log is append-only.",
      "enum": [
        "requested",
        "granted",
        "denied",
        "approval_requested",
        "lease_minted",
        "lease_used",
        "lease_renewed",
        "lease_expired",
        "lease_revoked",
        "grant_revoked",
        "break_glass",
        "rotated"
      ],
      "title": "AuditEvent",
      "type": "string"
    },
    "AuthMode": {
      "description": "How credentials are presented to a provider.",
      "enum": [
        "none",
        "bearer",
        "header_key",
        "query_param"
      ],
      "title": "AuthMode",
      "type": "string"
    },
    "BlastRadius": {
      "description": "How much can break if this Action is wrong.",
      "enum": [
        "none",
        "single_workload",
        "namespace",
        "cluster"
      ],
      "title": "BlastRadius",
      "type": "string"
    },
    "Capability": {
      "description": "A behaviour a model either demonstrably has or does not.\n\nMembership is established by probing, never by a hardcoded table - see\ncore.llm.probe.",
      "enum": [
        "tool_use",
        "json_mode",
        "vision",
        "streaming"
      ],
      "title": "Capability",
      "type": "string"
    },
    "CredentialAction": {
      "description": "Read and write are separate grants.\n\nApproving read never implies write, mirroring the connector split between\ninternal/readonly and internal/write.\n\nNOT_APPLICABLE exists for audit entries that concern no single access -\nbreak-glass and rotation, for instance. It is meaningful only on AuditEntry;\na Grant, Lease or AccessRequest carrying it is invalid, and Phase 3\nvalidation rejects it.\n\nIt is also why AuditEntry.action is not simply nullable: a nullable enum\nemits `anyOf: [$ref, null]`, which go-jsonschema v0.24.1 turns into two\nconflicting UnmarshalJSON methods on the same Go type. Stating \"not\napplicable\" explicitly is clearer than an implicit null convention anyway.",
      "enum": [
        "read",
        "write",
        "not_applicable"
      ],
      "title": "CredentialAction",
      "type": "string"
    },
    "CredentialRef": {
      "additionalProperties": false,
      "description": "A reference to a stored credential. Never the credential.\n\nSafe to persist, to attach to an Investigation and to render in the\ndashboard, because it identifies without disclosing.",
      "properties": {
        "id": {
          "description": "Opaque identifier of the stored credential.",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "description": "Human-readable label, e.g. 'prod-postgres'.",
          "title": "Name",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/CredentialScope"
        },
        "type": {
          "$ref": "#/$defs/CredentialType"
        }
      },
      "required": [
        "id",
        "name",
        "type"
      ],
      "title": "CredentialRef",
      "type": "object"
    },
    "CredentialScope": {
      "additionalProperties": false,
      "description": "Where a credential applies: a server, a service, an environment.",
      "properties": {
        "environment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "e.g. 'prod'. Drives defaults.",
          "title": "Environment"
        },
        "server": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Host or cluster, e.g. 'db-01'.",
          "title": "Server"
        },
        "service": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Logical service, e.g. 'checkout'.",
          "title": "Service"
        }
      },
      "title": "CredentialScope",
      "type": "object"
    },
    "CredentialType": {
      "description": "What kind of credential this is. Governs how the store handles it.",
      "enum": [
        "database",
        "ssh",
        "kubeconfig",
        "http_auth",
        "cloud_key",
        "tls",
        "key_value"
      ],
      "title": "CredentialType",
      "type": "string"
    },
    "Dialect": {
      "description": "Wire format a provider speaks.\n\nNamed by wire format rather than by vendor: a dialect outlives the vendor\nthat popularised it, and several vendors speak each one.\n\n- CHAT_COMPLETIONS: OpenRouter, Groq, Together, DeepSeek, Mistral, vLLM,\n  LM Studio, Ollama, OpenAI and most self-hosted stacks.\n- MESSAGES: Anthropic and API-compatible gateways.\n- GENERATE_CONTENT: Google Gemini.\n- RAW: bespoke HTTP APIs, mapped by configuration.",
      "enum": [
        "chat_completions",
        "messages",
        "generate_content",
        "raw"
      ],
      "title": "Dialect",
      "type": "string"
    },
    "EventEnvelope": {
      "additionalProperties": false,
      "description": "Transport wrapper carrying one event plus its correlation metadata.",
      "properties": {
        "emitted_at": {
          "format": "date-time",
          "title": "Emitted At",
          "type": "string"
        },
        "event": {
          "discriminator": {
            "mapping": {
              "approval_requested": "#/$defs/ApprovalRequestedEvent",
              "finding_produced": "#/$defs/FindingProducedEvent",
              "investigation_started": "#/$defs/InvestigationStartedEvent",
              "verdict_ready": "#/$defs/VerdictReadyEvent"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/InvestigationStartedEvent"
            },
            {
              "$ref": "#/$defs/FindingProducedEvent"
            },
            {
              "$ref": "#/$defs/VerdictReadyEvent"
            },
            {
              "$ref": "#/$defs/ApprovalRequestedEvent"
            }
          ],
          "title": "Event"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "emitted_at",
        "event"
      ],
      "title": "EventEnvelope",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "description": "A single observation, attributable to one connector at one moment.",
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "payload": {
          "additionalProperties": true,
          "description": "Kind-specific body. Phase 1 replaces this with per-kind models.",
          "title": "Payload",
          "type": "object"
        },
        "source": {
          "$ref": "#/$defs/EvidenceSource"
        },
        "summary": {
          "description": "One-line human-readable description.",
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "source",
        "observed_at",
        "summary"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "EvidenceKind": {
      "description": "What sort of observation this Evidence carries.",
      "enum": [
        "metric_window",
        "log_cluster",
        "manifest_diff",
        "k8s_event",
        "pipeline_run"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "EvidenceSource": {
      "additionalProperties": false,
      "description": "Where a piece of Evidence came from, so a human can go look themselves.",
      "properties": {
        "connector": {
          "description": "Connector that produced it, e.g. 'prometheus'.",
          "title": "Connector",
          "type": "string"
        },
        "query": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Query that produced it, if any.",
          "title": "Query"
        }
      },
      "required": [
        "connector"
      ],
      "title": "EvidenceSource",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "description": "One agent's supported claim about what it observed.",
      "properties": {
        "agent": {
          "description": "Codename of the agent that produced it, e.g. 'argus'.",
          "title": "Agent",
          "type": "string"
        },
        "confidence": {
          "description": "Agent's own confidence, 0 to 1.",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence": {
          "description": "Evidence supporting the claim. A Finding with none is inadmissible.",
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "rationale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Why the Evidence supports the claim.",
          "title": "Rationale"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "agent",
        "title",
        "severity",
        "confidence"
      ],
      "title": "Finding",
      "type": "object"
    },
    "FindingProducedEvent": {
      "additionalProperties": false,
      "description": "An agent returned a Finding.",
      "properties": {
        "finding": {
          "$ref": "#/$defs/Finding"
        },
        "investigation_id": {
          "format": "uuid",
          "title": "Investigation Id",
          "type": "string"
        },
        "type": {
          "const": "finding_produced",
          "default": "finding_produced",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "investigation_id",
        "finding"
      ],
      "title": "FindingProducedEvent",
      "type": "object"
    },
    "Grant": {
      "additionalProperties": false,
      "description": "Standing permission for one agent to reach one credential one way.",
      "properties": {
        "action": {
          "$ref": "#/$defs/CredentialAction"
        },
        "agent": {
          "description": "Agent codename the grant applies to, e.g. 'argus'.",
          "title": "Agent",
          "type": "string"
        },
        "credential_ref": {
          "$ref": "#/$defs/CredentialRef"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Set when mode is ALLOW_UNTIL.",
          "title": "Expires At"
        },
        "granted_at": {
          "format": "date-time",
          "title": "Granted At",
          "type": "string"
        },
        "granted_by": {
          "description": "Who approved it.",
          "title": "Granted By",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "investigation_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Set when mode is ALLOW_FOR_INVESTIGATION.",
          "title": "Investigation Id"
        },
        "mode": {
          "$ref": "#/$defs/PermissionMode"
        },
        "override_ask_default": {
          "default": false,
          "description": "Explicit override allowing ALLOW_UNTIL on a production or write grant.",
          "title": "Override Ask Default",
          "type": "boolean"
        },
        "revoked_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Set when revoked.",
          "title": "Revoked At"
        }
      },
      "required": [
        "id",
        "agent",
        "credential_ref",
        "action",
        "mode",
        "granted_by",
        "granted_at"
      ],
      "title": "Grant",
      "type": "object"
    },
    "Investigation": {
      "additionalProperties": false,
      "description": "One end-to-end run, from trigger to Verdict.",
      "properties": {
        "audit": {
          "description": "Cerberus credential audit for this run. Safe to expose: every credential here is a CredentialRef, never a value.",
          "items": {
            "$ref": "#/$defs/AuditEntry"
          },
          "title": "Audit",
          "type": "array"
        },
        "completed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completed At"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "title": "Findings",
          "type": "array"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "resolutions": {
          "description": "Every Delphi model resolution made during this run, in order.",
          "items": {
            "$ref": "#/$defs/ResolutionRecord"
          },
          "title": "Resolutions",
          "type": "array"
        },
        "state": {
          "$ref": "#/$defs/InvestigationState"
        },
        "trigger": {
          "$ref": "#/$defs/Trigger"
        },
        "verdict": {
          "anyOf": [
            {
              "$ref": "#/$defs/Verdict"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Absent until the run reaches a conclusion."
        }
      },
      "required": [
        "id",
        "state",
        "trigger",
        "created_at"
      ],
      "title": "Investigation",
      "type": "object"
    },
    "InvestigationStartedEvent": {
      "additionalProperties": false,
      "description": "An Investigation moved out of PENDING.",
      "properties": {
        "investigation_id": {
          "format": "uuid",
          "title": "Investigation Id",
          "type": "string"
        },
        "type": {
          "const": "investigation_started",
          "default": "investigation_started",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "investigation_id"
      ],
      "title": "InvestigationStartedEvent",
      "type": "object"
    },
    "InvestigationState": {
      "description": "Lifecycle of an Investigation.",
      "enum": [
        "pending",
        "planning",
        "running",
        "awaiting_approval",
        "completed",
        "failed",
        "cancelled"
      ],
      "title": "InvestigationState",
      "type": "string"
    },
    "Lease": {
      "additionalProperties": false,
      "description": "Permission to use a credential, bound to one connector and one run.\n\nA lease is not a credential. It is redeemable only by the named connector,\nonly for the named investigation, and only until it expires - so a leaked\nlease is worthless anywhere else.",
      "properties": {
        "action": {
          "$ref": "#/$defs/CredentialAction"
        },
        "connector": {
          "description": "The only connector that may redeem this lease.",
          "title": "Connector",
          "type": "string"
        },
        "credential_ref": {
          "$ref": "#/$defs/CredentialRef"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "investigation_id": {
          "format": "uuid",
          "title": "Investigation Id",
          "type": "string"
        },
        "issued_at": {
          "format": "date-time",
          "title": "Issued At",
          "type": "string"
        },
        "renewable": {
          "default": true,
          "description": "Auto-renews while the underlying grant is valid and the run is live.",
          "title": "Renewable",
          "type": "boolean"
        },
        "renewed_count": {
          "default": 0,
          "minimum": 0,
          "title": "Renewed Count",
          "type": "integer"
        },
        "request_id": {
          "format": "uuid",
          "title": "Request Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "request_id",
        "investigation_id",
        "connector",
        "credential_ref",
        "action",
        "issued_at",
        "expires_at"
      ],
      "title": "Lease",
      "type": "object"
    },
    "ModelDescriptor": {
      "additionalProperties": false,
      "description": "One model as observed, not as advertised.\n\nEvery field below the identity pair is measured by core.llm.probe against\nthis deployment, because a model's behaviour behind a particular gateway is\nnot always what its vendor documents.",
      "properties": {
        "capabilities": {
          "description": "Probed, not declared.",
          "items": {
            "$ref": "#/$defs/Capability"
          },
          "title": "Capabilities",
          "type": "array"
        },
        "context_window": {
          "default": 0,
          "minimum": 0,
          "title": "Context Window",
          "type": "integer"
        },
        "input_cost_per_1k": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Cost Per 1K"
        },
        "last_probed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Null means never probed; treat capabilities as unknown.",
          "title": "Last Probed At"
        },
        "median_latency_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Median Latency Ms"
        },
        "model_id": {
          "title": "Model Id",
          "type": "string"
        },
        "output_cost_per_1k": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Cost Per 1K"
        },
        "provider_id": {
          "title": "Provider Id",
          "type": "string"
        }
      },
      "required": [
        "provider_id",
        "model_id"
      ],
      "title": "ModelDescriptor",
      "type": "object"
    },
    "ModelRequirements": {
      "additionalProperties": false,
      "description": "What an agent needs from a model. The only thing an agent may declare.",
      "properties": {
        "capabilities": {
          "description": "Capabilities the model must demonstrably have.",
          "items": {
            "$ref": "#/$defs/Capability"
          },
          "title": "Capabilities",
          "type": "array"
        },
        "max_cost_per_call": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Ceiling for one call. Enforced via core.guardrails.budget.",
          "title": "Max Cost Per Call"
        },
        "min_context": {
          "default": 0,
          "description": "Minimum context window in tokens.",
          "minimum": 0,
          "title": "Min Context",
          "type": "integer"
        },
        "tier": {
          "$ref": "#/$defs/Tier",
          "default": "balanced"
        }
      },
      "title": "ModelRequirements",
      "type": "object"
    },
    "PermissionMode": {
      "description": "How a grant answers a request.\n\nALLOW_UNTIL is refused for production targets and for any write action\nunless an explicit override is set - see core.cerberus.policy.defaults.",
      "enum": [
        "deny",
        "ask_each_time",
        "allow_for_investigation",
        "allow_until"
      ],
      "title": "PermissionMode",
      "type": "string"
    },
    "ProviderConfig": {
      "additionalProperties": false,
      "description": "A configured provider. Added from settings, never from code.",
      "properties": {
        "auth_mode": {
          "$ref": "#/$defs/AuthMode",
          "default": "bearer"
        },
        "base_url": {
          "description": "Root URL of the provider's API.",
          "title": "Base Url",
          "type": "string"
        },
        "dialect": {
          "$ref": "#/$defs/Dialect"
        },
        "display_name": {
          "title": "Display Name",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "id": {
          "description": "Stable identifier, e.g. 'local-ollama'.",
          "title": "Id",
          "type": "string"
        },
        "manual_models": {
          "description": "Model ids entered by hand when enumeration is absent.",
          "items": {
            "type": "string"
          },
          "title": "Manual Models",
          "type": "array"
        },
        "models_endpoint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Path used to enumerate models, when the provider offers one.",
          "title": "Models Endpoint"
        },
        "secret_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Cerberus credential reference. Never the credential itself.",
          "title": "Secret Ref"
        }
      },
      "required": [
        "id",
        "display_name",
        "dialect",
        "base_url"
      ],
      "title": "ProviderConfig",
      "type": "object"
    },
    "ResolutionRecord": {
      "additionalProperties": false,
      "description": "Why Delphi chose the model it chose, for one call.\n\nAttached to the Investigation so a run is reproducible and can explain its\nown cost without being re-run.",
      "properties": {
        "chosen": {
          "$ref": "#/$defs/ModelDescriptor"
        },
        "estimated_cost": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimated Cost"
        },
        "fallback_used": {
          "default": false,
          "title": "Fallback Used",
          "type": "boolean"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "matched_step": {
          "$ref": "#/$defs/ResolutionStep"
        },
        "rejected": {
          "description": "Human-readable reason per rejected candidate, in evaluation order.",
          "items": {
            "type": "string"
          },
          "title": "Rejected",
          "type": "array"
        },
        "requested_by": {
          "description": "Agent codename that consulted Delphi, e.g. 'hermes'.",
          "title": "Requested By",
          "type": "string"
        },
        "requirements": {
          "$ref": "#/$defs/ModelRequirements"
        },
        "resolved_at": {
          "format": "date-time",
          "title": "Resolved At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "requested_by",
        "requirements",
        "matched_step",
        "chosen",
        "resolved_at"
      ],
      "title": "ResolutionRecord",
      "type": "object"
    },
    "ResolutionStep": {
      "description": "Which rung of the resolution cascade produced the answer.",
      "enum": [
        "task_override",
        "agent_binding",
        "tier_default",
        "global_default"
      ],
      "title": "ResolutionStep",
      "type": "string"
    },
    "Severity": {
      "description": "How much a Finding should worry the on-call engineer.",
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "Severity",
      "type": "string"
    },
    "Tier": {
      "description": "Cost/capability band an agent asks for, rather than a specific model.",
      "enum": [
        "cheap",
        "balanced",
        "frontier"
      ],
      "title": "Tier",
      "type": "string"
    },
    "Trigger": {
      "additionalProperties": false,
      "description": "The inbound event that started everything.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/TriggerKind"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        },
        "received_at": {
          "format": "date-time",
          "title": "Received At",
          "type": "string"
        },
        "source": {
          "description": "Who sent it, e.g. 'alertmanager'.",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "received_at",
        "source"
      ],
      "title": "Trigger",
      "type": "object"
    },
    "TriggerKind": {
      "description": "What set an Investigation off.",
      "enum": [
        "alert",
        "webhook",
        "schedule",
        "human_question"
      ],
      "title": "TriggerKind",
      "type": "string"
    },
    "UIActionResponse": {
      "additionalProperties": false,
      "description": "A user's response to an action, travelling back over AG-UI.\n\nMirrors A2UI's client action message. Carries no decision authority of its\nown: an approval reaching the Approval Gate, or an access decision reaching\nCerberus, is re-validated there against the request it claims to answer.",
      "properties": {
        "action_name": {
          "title": "Action Name",
          "type": "string"
        },
        "context": {
          "additionalProperties": true,
          "title": "Context",
          "type": "object"
        },
        "investigation_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Investigation Id"
        },
        "source_component_id": {
          "title": "Source Component Id",
          "type": "string"
        },
        "surface_id": {
          "format": "uuid",
          "title": "Surface Id",
          "type": "string"
        }
      },
      "required": [
        "surface_id",
        "source_component_id",
        "action_name"
      ],
      "title": "UIActionResponse",
      "type": "object"
    },
    "Verdict": {
      "additionalProperties": false,
      "description": "The orchestrator's ranked conclusion for one Investigation.",
      "properties": {
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "contributing_findings": {
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "title": "Contributing Findings",
          "type": "array"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "investigation_id": {
          "format": "uuid",
          "title": "Investigation Id",
          "type": "string"
        },
        "recommended_actions": {
          "items": {
            "$ref": "#/$defs/Action"
          },
          "title": "Recommended Actions",
          "type": "array"
        },
        "root_cause": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Null when the evidence does not support a conclusion.",
          "title": "Root Cause"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "id",
        "investigation_id",
        "confidence",
        "summary"
      ],
      "title": "Verdict",
      "type": "object"
    },
    "VerdictReadyEvent": {
      "additionalProperties": false,
      "description": "The aggregator reached a conclusion.",
      "properties": {
        "investigation_id": {
          "format": "uuid",
          "title": "Investigation Id",
          "type": "string"
        },
        "type": {
          "const": "verdict_ready",
          "default": "verdict_ready",
          "title": "Type",
          "type": "string"
        },
        "verdict": {
          "$ref": "#/$defs/Verdict"
        }
      },
      "required": [
        "investigation_id",
        "verdict"
      ],
      "title": "VerdictReadyEvent",
      "type": "object"
    }
  }
}
