# Container image: base for the Python MCP connectors.
#
# Phase: 6 - Go Port & Platform Binaries
#
# Built from the repo root: docker build -f deploy/docker/Dockerfile.connector-py .

FROM python:3.12-slim AS base
ENV PYTHONUNBUFFERED=1     PYTHONDONTWRITEBYTECODE=1     UV_COMPILE_BYTECODE=1     UV_LINK_MODE=copy
WORKDIR /app
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

FROM base AS deps
COPY pyproject.toml uv.lock .python-version ./
RUN uv sync --frozen --no-dev --no-install-project

FROM base AS runtime
COPY --from=deps /app/.venv /app/.venv
ENV PATH="/app/.venv/bin:$PATH"
COPY pyproject.toml ./
COPY core ./core
COPY connectors ./connectors
RUN useradd --system --uid 10001 pantheon && chown -R pantheon:pantheon /app
USER pantheon
ENV PANTHEON_CONNECTOR=""

# TODO: Phase 6 - pin the base image by digest and add a healthcheck
CMD ["python", "-m", "connectors"]
