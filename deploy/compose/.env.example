# Environment for the Compose stack.
#
# Phase: 6 - Go Port & Platform Binaries
#
# Copy to .env in this directory. Every value here has a working default in
# docker-compose.yml, so the stack comes up untouched - override only what you
# need. The repo-root .env.example documents the full application surface.

# --- ports exposed on the host -------------------------------------------
PANTHEON_API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
OLLAMA_PORT=11434

# --- datastores -----------------------------------------------------------
POSTGRES_DB=pantheon
POSTGRES_USER=pantheon
POSTGRES_PASSWORD=pantheon

# --- object storage (MinIO by default, any S3-compatible endpoint) --------
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=pantheon
S3_SECRET_KEY=pantheon123
S3_REGION=us-east-1
S3_BUCKET_REPORTS=pantheon-reports
S3_BUCKET_ARTIFACTS=pantheon-artifacts
S3_BUCKET_BACKUPS=pantheon-backups
S3_USE_SSL=false

# --- Delphi ---------------------------------------------------------------
# Defaults target the bundled Ollama, so the stack runs with no API keys.
# Enable it with: docker compose --profile llm-local up
LLM_PROVIDER_ID=local-ollama
LLM_DIALECT=chat_completions
LLM_BASE_URL=http://ollama:11434/v1
LLM_AUTH_MODE=none
LLM_API_KEY=
LLM_TIER_CHEAP_MODEL=qwen2.5:3b
LLM_TIER_BALANCED_MODEL=qwen2.5:14b
LLM_TIER_FRONTIER_MODEL=qwen2.5:32b

# --- observability overlay ------------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_PASSWORD=admin
LOKI_PORT=3100
TEMPO_PORT=3200
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
