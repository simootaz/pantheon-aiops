# Pantheon environment template.
# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Phase: 0 - Scaffold & Tooling
# TODO: Phase 1 - add the variables each subsystem actually reads as it lands.

# ---------------------------------------------------------------------------
# Platform
# ---------------------------------------------------------------------------
PANTHEON_ENV=local
PANTHEON_LOG_LEVEL=INFO
PANTHEON_API_HOST=0.0.0.0
PANTHEON_API_PORT=8000

# ---------------------------------------------------------------------------
# Datastores
# ---------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pantheon
POSTGRES_USER=pantheon
POSTGRES_PASSWORD=

REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Temporal (core/workflows)
# ---------------------------------------------------------------------------
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=pantheon

# ---------------------------------------------------------------------------
# Delphi - the LLM gateway (core/llm)
#
# Agents never name a model; they declare requirements and Delphi resolves them.
# These variables seed the bootstrap provider and the tier defaults. Everything
# else is configured from the settings UI at Phase 4.
# See docs/adr/0004-llm-provider-abstraction.md.
#
# The defaults below point at a local Ollama, so `make up` gives a working stack
# with ZERO API keys. Bring your own provider by changing LLM_BASE_URL.
# ---------------------------------------------------------------------------
# Swapping providers is a settings change and nothing else. That is ADR 0004's
# acceptance test, and the two blocks below are the demonstration: same dialect,
# same code, different vendor.
#
# --- Groq (hosted, needs a key) --------------------------------------------
LLM_PROVIDER_ID=groq
LLM_DISPLAY_NAME=Groq

# One of: chat_completions | messages | generate_content | raw
# chat_completions is spoken by OpenRouter, Groq, Together, DeepSeek, Mistral,
# vLLM, LM Studio, Ollama, OpenAI and most self-hosted stacks.
LLM_DIALECT=chat_completions
LLM_BASE_URL=https://api.groq.com/openai/v1

# One of: none | bearer | header_key | query_param
LLM_AUTH_MODE=bearer
LLM_API_KEY=

# Tier defaults. Agents ask for a tier, never a model.
#
# Model ids move: vendors deprecate and rename, and a name that worked last
# quarter can 404 today. These are settings for exactly that reason - a rename
# is an edit here, not a release. `make test-delphi` names the model it actually
# reached, so a stale id shows up as a failure that says which one.
LLM_TIER_CHEAP_MODEL=llama-3.1-8b-instant
LLM_TIER_BALANCED_MODEL=llama-3.3-70b-versatile
LLM_TIER_FRONTIER_MODEL=llama-3.3-70b-versatile

# --- Local Ollama (no key, no network) -------------------------------------
# Uncomment this block and comment the one above to run without a hosted
# provider. Nothing in the code changes.
#
# LLM_PROVIDER_ID=local-ollama
# LLM_DISPLAY_NAME=Local Ollama
# LLM_DIALECT=chat_completions
# LLM_BASE_URL=http://ollama:11434/v1
# LLM_AUTH_MODE=none
# LLM_API_KEY=
# LLM_TIER_CHEAP_MODEL=qwen2.5:3b
# LLM_TIER_BALANCED_MODEL=qwen2.5:14b
# LLM_TIER_FRONTIER_MODEL=qwen2.5:32b
LLM_GLOBAL_DEFAULT_TIER=balanced

LLM_MAX_TOKENS=8192
LLM_REQUEST_TIMEOUT_SECONDS=120
LLM_MAX_COST_PER_CALL=

# ---------------------------------------------------------------------------
# Object storage - MinIO by default, any S3-compatible endpoint
#
# docs/adr/0001-object-storage-minio.md: Pantheon runs fully self-hosted with no
# cloud account. Point S3_ENDPOINT_URL at real S3, Ceph RGW, Wasabi, B2 or R2
# without touching code.
# ---------------------------------------------------------------------------
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=pantheon
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_BUCKET_REPORTS=pantheon-reports
S3_BUCKET_ARTIFACTS=pantheon-artifacts
S3_BUCKET_BACKUPS=pantheon-backups
S3_USE_SSL=false

# ---------------------------------------------------------------------------
# Connector endpoints
# ---------------------------------------------------------------------------
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
PUSHGATEWAY_URL=http://localhost:9091
ALERTMANAGER_URL=http://localhost:9093
# Shared secret for POST /webhooks/alertmanager. Empty disables verification.
ALERTMANAGER_WEBHOOK_TOKEN=
KUBECONFIG=
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=
# Shared secret for POST /webhooks/gitlab. Empty disables verification, which
# is fine locally and is not fine anywhere a real GitLab can reach.
GITLAB_WEBHOOK_TOKEN=
GITHUB_TOKEN=
LITMUS_URL=

# ---------------------------------------------------------------------------
# Observability (core/observability)
# ---------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=pantheon

# ---------------------------------------------------------------------------
# Dashboard
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Cerberus - the credential broker (core/cerberus)
#
# Agents never receive plaintext. CERBERUS_MASTER_KEY wraps the envelope keys;
# it has NO default and PANTHEON_ENV=production refuses to start without it.
# See docs/adr/0005-credential-brokering.md.
# ---------------------------------------------------------------------------
CERBERUS_MASTER_KEY=
CERBERUS_LEASE_SECONDS=900
CERBERUS_AUDIT_RETENTION_DAYS=90

# ---------------------------------------------------------------------------
# Simulator
#
# Where synthetic pipeline events are POSTed, and the default compression.
# The default speed is held under simulator.runner.max_honest_speed by a guard:
# asking for more than a tick can deliver makes the runner report falling
# behind on every ordinary run.
# ---------------------------------------------------------------------------
SIM_WEBHOOK_URL=http://localhost:8000/webhooks/gitlab
SIM_DEFAULT_SPEED=500
