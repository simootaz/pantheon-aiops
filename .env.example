# Pantheon environment template.
# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Phase: 0 - Scaffold & Tooling
# TODO: Phase 1 - add the variables each subsystem actually reads as it lands.

# ---------------------------------------------------------------------------
# Platform
# ---------------------------------------------------------------------------
PANTHEON_ENV=local
PANTHEON_LOG_LEVEL=INFO
PANTHEON_API_HOST=0.0.0.0
PANTHEON_API_PORT=8000

# ---------------------------------------------------------------------------
# Datastores
# ---------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pantheon
POSTGRES_USER=pantheon
POSTGRES_PASSWORD=

REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Temporal (core/workflows)
# ---------------------------------------------------------------------------
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=pantheon

# ---------------------------------------------------------------------------
# LLM provider (core/llm)
#
# Provider-neutral by design, for the same reason object storage is
# (docs/adr/0001-object-storage-minio.md): the platform must not be welded to
# one vendor. Point PANTHEON_LLM_BASE_URL at any compatible chat-completions
# endpoint, including a self-hosted one.
# ---------------------------------------------------------------------------
PANTHEON_LLM_PROVIDER=
PANTHEON_LLM_BASE_URL=
PANTHEON_LLM_API_KEY=
PANTHEON_LLM_MODEL=
PANTHEON_LLM_MAX_TOKENS=8192

# ---------------------------------------------------------------------------
# Connector endpoints
# ---------------------------------------------------------------------------
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
ALERTMANAGER_URL=http://localhost:9093
KUBECONFIG=
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=
GITHUB_TOKEN=
LITMUS_URL=

# ---------------------------------------------------------------------------
# Observability (core/observability)
# ---------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=pantheon

# ---------------------------------------------------------------------------
# Dashboard
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
